 namespace {
 
+#if defined(DYNARMIC_EXTERNAL_CODE_MEMORY)
+struct SpinLockAllocator : public Xbyak::Allocator {
+    uint8_t* alloc(size_t size) override {
+        void* p = dynarmic_code_alloc(size);
+        if (p == nullptr) {
+            throw Xbyak::Error(Xbyak::ERR_CANT_ALLOC);
+        }
+        dynarmic_code_commit(p, size);  // a fixed buffer: usable at once
+        return static_cast<uint8_t*>(p);
+    }
+    void free(uint8_t* p) override { dynarmic_code_free(p); }
+    bool useProtect() const override { return false; }
+};
+SpinLockAllocator s_allocator;  // defined before impl: constructed first
