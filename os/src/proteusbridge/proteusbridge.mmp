// proteusbridge.mmp -- a tiny ARM console EXE for the native system-library bridge (rung R1): it calls euser for descriptors,
// RArray without a comparator and the heap, and reports the number of the first failing check as its exit code (0 = all pass).
TARGET			proteusbridge.exe
TARGETTYPE		exe
UID				0x1000007a 0xE70157F3
CAPABILITY		NONE
VENDORID		0

OS_LAYER_SYSTEMINCLUDE_SYMBIAN

SOURCEPATH		.
SOURCE			proteusbridge.cpp

LIBRARY			euser.lib
