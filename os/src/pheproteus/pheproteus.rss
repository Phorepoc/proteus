	{
	items =
		{
		AVKON_ENUMERATED_TEXT { value = 0; text = "Off"; },
		AVKON_ENUMERATED_TEXT { value = 1; text = "All libraries"; },
		AVKON_ENUMERATED_TEXT { value = 2; text = "euser"; },
		AVKON_ENUMERATED_TEXT { value = 3; text = "efsrv"; },
		AVKON_ENUMERATED_TEXT { value = 4; text = "libc"; },
		AVKON_ENUMERATED_TEXT { value = 5; text = "libpthread"; }
		};
	}
