// proteusdll.mmp -- OURS (Proteus P2): the smallest real ARM Symbian DLL (C exports, imports euser; writable static data + a static constructor, run by _E32Dll). ARM build: ./ph arm proteusdll.
TARGET			proteusdll.dll
TARGETTYPE		dll
UID				0x1000008d 0xE70157F2
CAPABILITY		All -Tcb
VENDORID		0
EPOCALLOWDLLDATA
DEFFILE			proteusdll.def

OS_LAYER_SYSTEMINCLUDE_SYMBIAN

SOURCEPATH		.
SOURCE			proteusdll.cpp

LIBRARY			euser.lib
