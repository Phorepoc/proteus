// proteus.mmp -- OURS (Proteus P0): proteus.exe = user-side ARM loader + interpreter (see proteus.cpp). x32 Phorepoc EXE; SSM_TEST=proteus runs it at boot.
TARGET			proteus.exe
TARGETTYPE		exe
UID				0x1000007a 0xE70157F1
EPOCSTACKSIZE	0x10000
CAPABILITY		All -TCB
VENDORID		0
// the heap holds the ARM images the guest loads (Mesa's phgl.dll alone is 15 MB): a reservation, committed as used
EPOCHEAPSIZE	0x10000 0x10000000

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE_SYMBIAN
USERINCLUDE		.
SOURCEPATH		.
SOURCE			proteus.cpp armcpu.cpp thumb.cpp proteusrt.cpp e32decomp.cpp proteusexec.cpp proteusgl.cpp
LIBRARY			euser.lib efsrv.lib libc.lib libm.lib ws32.lib apparc.lib mmfcontrollerframework.lib
